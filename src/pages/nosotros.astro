---
import Layout from "../layouts/Layout.astro";
---

<Layout titulo="Nosotros | Espacio Cultural">
    <section class="seccion nosotros">
        <div>
            <h1>Sobre nosotros</h1>
            <p>
                Espacio Cultural es una organización dedicada a acercar el arte
                y la creatividad a la comunidad. Nuestro propósito es ofrecer un
                lugar abierto donde las personas puedan aprender, expresarse y
                compartir sus ideas a través de talleres y actividades.
            </p>
        </div>
        <img src="public/arpilleras-7.jpg" alt="Equipo de Espacio Cultural" />
    </section>
</Layout>
